import java.util.Scanner;

public class SlidingWindow {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int windowSize, totalFrames;

        System.out.print("Enter window size: ");
        windowSize = sc.nextInt();

        System.out.print("\nEnter no of frames to transmit: ");
        totalFrames = sc.nextInt();

        int[] frames = new int[totalFrames];

        System.out.print("\nEnter " + totalFrames + " frames: ");
        for (int i = 0; i < totalFrames; i++) {
            frames[i] = sc.nextInt();
        }

        System.out.println("\nSliding Window Protocol Simulation (assuming no frame loss/error)");
        System.out.println("Sender sends " + windowSize +
                           " frames at a time and waits for acknowledgement\n");

        for (int i = 0; i < totalFrames; i++) {
            System.out.print(frames[i] + " ");

            if ((i + 1) % windowSize == 0) {
                System.out.println("\nAcknowledgement of above frames is received by sender\n");
            }
        }

        // Acknowledgement for remaining frames
        if (totalFrames % windowSize != 0) {
            System.out.println("\nAcknowledgement of above frames is received by sender");
        }

        sc.close();
    }
}
